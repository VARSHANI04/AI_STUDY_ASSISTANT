def get_study_material():

    print("\n" + "=" * 70)
    print("MODULE 1 - STUDY MATERIAL INPUT")
    print("=" * 70)

    print("\nEnter or paste your study material.")
    print("Type END on a new line when you finish.\n")

    lines = []

    while True:
        line = input()

        if line.strip().upper() == "END":
            break

        lines.append(line)

    material = "\n".join(lines).strip()

    if not material:
        print("\nERROR: Study material cannot be empty.")
        return None

    if len(material) < 100:
        print("\nWARNING: The material is very short.")
        print("For better results, provide more study content.")

    print("\nStudy material received successfully.")
    print("Characters:", len(material))
    print("Words:", len(material.split()))

    return material


# ============================================================
#              MODULE 2: TEXT PREPROCESSING
# ============================================================

def preprocess_text(text):

    print("\n" + "=" * 70)
    print("MODULE 2 - TEXT PREPROCESSING")
    print("=" * 70)

    # Remove excessive spaces
    text = re.sub(r"\s+", " ", text)

    # Remove unnecessary special characters
    text = re.sub(r"[^\w\s.,!?():;%+\-/]", "", text)

    text = text.strip()

    # Sentence splitting
    sentences = nltk.sent_tokenize(text)

    print("Preprocessing completed.")
    print("Number of sentences:", len(sentences))
    print("Number of words:", len(text.split()))

    return text, sentences


# ============================================================
#              MODULE 3: AI SUMMARIZATION
# ============================================================

def load_summarizer():

    print("\nLoading AI summarization model...")
    print("This may take some time during the first run.\n")

    try:
        model = pipeline(
            "summarization",
            model="sshleifer/distilbart-cnn-12-6"
        )

        print("Summarization model loaded successfully.")

        return model

    except Exception as e:

        print("Could not load summarization model.")
        print("Error:", e)

        return None


def split_into_chunks(text, max_words=350):

    words = text.split()

    chunks = []

    for i in range(0, len(words), max_words):
        chunk = " ".join(words[i:i + max_words])

        if len(chunk.split()) >= 30:
            chunks.append(chunk)

    return chunks


def generate_summary(text, summarizer):

    print("\n" + "=" * 70)
    print("MODULE 3 - AI SUMMARIZATION")
    print("=" * 70)

    if summarizer is None:
        print("Summarizer unavailable.")
        return ""

    chunks = split_into_chunks(text)

    if not chunks:
        chunks = [text]

    summaries = []

    for i, chunk in enumerate(chunks):

        print(f"Processing section {i + 1}/{len(chunks)}...")

        try:

            word_count = len(chunk.split())

            max_length = min(130, max(50, word_count // 2))
            min_length = min(50, max(20, word_count // 4))

            if max_length <= min_length:
                max_length = min_length + 10

            result = summarizer(
                chunk,
                max_length=max_length,
                min_length=min_length,
                do_sample=False
            )

            summaries.append(result[0]["summary_text"])

        except Exception as e:

            print("Warning while summarizing a section:", e)

            # Fallback: first few sentences
            sentences = nltk.sent_tokenize(chunk)
            summaries.append(" ".join(sentences[:3]))

    final_summary = " ".join(summaries)

    print("\nSUMMARY")
    print("-" * 70)
    print(final_summary)

    return final_summary


# ============================================================
#          MODULE 4: KEY POINT EXTRACTION
# ============================================================

def extract_key_points(text, number_of_points=8):

    print("\n" + "=" * 70)
    print("KEY POINTS")
    print("=" * 70)

    sentences = nltk.sent_tokenize(text)

    if len(sentences) <= number_of_points:
        selected = sentences
    else:

        # TF-IDF based important sentence selection
        try:

            vectorizer = TfidfVectorizer(
                stop_words="english"
            )

            matrix = vectorizer.fit_transform(sentences)

            scores = matrix.sum(axis=1).A1

            ranked = sorted(
                enumerate(scores),
                key=lambda x: x[1],
                reverse=True
            )

            selected_indices = sorted(
                [x[0] for x in ranked[:number_of_points]]
            )

            selected = [sentences[i] for i in selected_indices]

        except Exception:

            selected = sentences[:number_of_points]

    for i, point in enumerate(selected, 1):
        print(f"{i}. {point}")

    return selected


# ============================================================
#            MODULE 5: QUESTION GENERATION
# ============================================================

def generate_questions(sentences, number_of_questions=5):

    print("\n" + "=" * 70)
    print("MODULE 5 - QUESTION GENERATION")
    print("=" * 70)

    usable_sentences = []

    for sentence in sentences:

        words = sentence.split()

        if len(words) >= 7:
            usable_sentences.append(sentence)

    if len(usable_sentences) < 3:

        print("Not enough suitable sentences for question generation.")

        return []

    # Select sentences
    selected = random.sample(
        usable_sentences,
        min(number_of_questions, len(usable_sentences))
    )

    questions = []

    for sentence in selected:

        words = sentence.split()

        # Find useful words
        candidates = []

        for word in words:

            clean_word = re.sub(
                r"[^A-Za-z0-9]",
                "",
                word
            )

            if len(clean_word) >= 5:
                candidates.append(clean_word)

        if not candidates:
            continue

        answer = random.choice(candidates)

        # Replace selected word in sentence
        pattern = re.compile(
            re.escape(answer),
            re.IGNORECASE
        )

        question_sentence = pattern.sub(
            "__________",
            sentence,
            count=1
        )

        if question_sentence == sentence:
            continue

        question = {
            "question": "Fill in the blank: " + question_sentence,
            "answer": answer
        }

        questions.append(question)

    # If not enough questions, create simple conceptual questions
    if len(questions) == 0:

        for sentence in selected:

            questions.append({
                "question": "Explain the following concept:\n" + sentence,
                "answer": sentence
            })

    print("Generated questions:", len(questions))

    for i, q in enumerate(questions, 1):

        print(f"\nQ{i}. {q['question']}")
        print("Answer:", q["answer"])

    return questions


# ============================================================
#               MODULE 6: QUIZ SYSTEM
# ============================================================

def run_quiz(questions):

    print("\n" + "=" * 70)
    print("MODULE 6 - QUIZ & ANSWER EVALUATION")
    print("=" * 70)

    if not questions:
        print("No questions available.")
        return 0

    score = 0
    total = len(questions)

    print("\nAnswer each question.")
    print("For Fill-in-the-Blank questions, type the missing word.")
    print()

    for i, q in enumerate(questions, 1):

        print("-" * 70)
        print(f"Question {i}/{total}")
        print(q["question"])

        user_answer = input("\nYour answer: ").strip()

        correct_answer = q["answer"].strip()

        # Normalize answers
        user_clean = re.sub(
            r"[^a-zA-Z0-9 ]",
            "",
            user_answer
        ).lower()

        correct_clean = re.sub(
            r"[^a-zA-Z0-9 ]",
            "",
            correct_answer
        ).lower()

        if user_clean == correct_clean:

            print("Correct!")
            score += 1

        elif (
            user_clean in correct_clean
            or correct_clean in user_clean
        ) and len(user_clean) > 3:

            print("Correct / Acceptable!")
            score += 1

        else:

            print("Incorrect.")
            print("Correct answer:", correct_answer)

    percentage = (score / total) * 100

    print("\n" + "=" * 70)
    print("QUIZ RESULT")
    print("=" * 70)

    print("Score:", score, "/", total)
    print(f"Percentage: {percentage:.2f}%")

    if percentage >= 80:
        print("Performance: Excellent")

    elif percentage >= 60:
        print("Performance: Good")

    elif percentage >= 40:
        print("Performance: Needs Improvement")

    else:
        print("Performance: More Practice Recommended")

    return percentage


# ============================================================
#       MODULE 7: AI STUDY ASSISTANT / Q&A
# ============================================================

def answer_question(question, study_material):

    print("\n" + "=" * 70)
    print("MODULE 7 - AI STUDY ASSISTANT")
    print("=" * 70)

    if not question.strip():

        print("Please enter a question.")

        return ""

    sentences = nltk.sent_tokenize(study_material)

    if not sentences:

        return "No study material is available."

    try:

        # TF-IDF retrieval
        documents = sentences + [question]

        vectorizer = TfidfVectorizer(
            stop_words="english"
        )

        matrix = vectorizer.fit_transform(documents)

        similarities = cosine_similarity(
            matrix[-1],
            matrix[:-1]
        )[0]

        best_indices = similarities.argsort()[-3:][::-1]

        relevant_sentences = []

        for index in best_indices:

            if similarities[index] > 0:

                relevant_sentences.append(
                    sentences[index]
                )

        if not relevant_sentences:

            return (
                "I could not find a relevant answer "
                "in the provided study material."
            )

        answer = " ".join(relevant_sentences)

        print("\nQuestion:")
        print(question)

        print("\nAnswer based on your study material:")
        print("-" * 70)
        print(answer)

        return answer

    except Exception as e:

        print("Error while answering question:", e)

        return "Unable to process the question."


