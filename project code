def main():

    # --------------------------------------------------------
    # STEP 1: GET MATERIAL
    # --------------------------------------------------------

    material = get_study_material()

    if material is None:
        return

    # --------------------------------------------------------
    # STEP 2: PREPROCESS
    # --------------------------------------------------------

    processed_text, sentences = preprocess_text(material)

    # --------------------------------------------------------
    # STEP 3: LOAD AI MODEL
    # --------------------------------------------------------

    summarizer = load_summarizer()

    # --------------------------------------------------------
    # STEP 4: SUMMARY
    # --------------------------------------------------------

    summary = generate_summary(
        processed_text,
        summarizer
    )

    # --------------------------------------------------------
    # STEP 5: KEY POINTS
    # --------------------------------------------------------

    key_points = extract_key_points(
        processed_text,
        number_of_points=8
    )

    # --------------------------------------------------------
    # STEP 6: QUESTIONS
    # --------------------------------------------------------

    questions = generate_questions(
        sentences,
        number_of_questions=5
    )

    # --------------------------------------------------------
    # STEP 7: QUIZ
    # --------------------------------------------------------

    quiz_percentage = 0

    if questions:

        take_quiz = input(
            "\nDo you want to take the quiz? (yes/no): "
        ).strip().lower()

        if take_quiz in ["yes", "y"]:

            quiz_percentage = run_quiz(
                questions
            )

    # --------------------------------------------------------
    # STEP 8: STUDY ASSISTANT
    # --------------------------------------------------------

    while True:

        print("\n" + "=" * 70)
        print("AI STUDY ASSISTANT - ASK A QUESTION")
        print("=" * 70)

        question = input(
            "\nEnter your question "
            "(type EXIT to finish): "
        ).strip()

        if question.upper() == "EXIT":
            break

        answer_question(
            question,
            processed_text
        )

    # --------------------------------------------------------
    # STEP 9: FINAL REPORT
    # --------------------------------------------------------

    generate_study_report(
        material,
        summary,
        key_points,
        quiz_percentage
    )

    print("\n" + "=" * 70)
    print("PROJECT EXECUTION COMPLETED")
    print("=" * 70)

    print("\nThe AI Study Assistant demonstrated:")
    print("✓ Study material input")
    print("✓ Text preprocessing")
    print("✓ AI summarization")
    print("✓ Important point extraction")
    print("✓ Question generation")
    print("✓ Quiz and answer evaluation")
    print("✓ Study material based Q&A")
    print("✓ Basic performance reporting")

    print("\nYou can now take screenshots of the outputs")
    print("for your project report and GitHub documentation.")

main()
